# TIC-VLA DynaNav / Isaac Sim testing on the Ubuntu 22.04 host.
export ISAAC_SIM_ROOT=/data/isaacsim
export ISAAC_SIM_PYTHON="${ISAAC_SIM_ROOT}/python.sh"
# Resolve the repository from this file, so host and container mount paths both work.
TICVLA_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export TICVLA_REPO_ROOT
export TICVLA_DYNANAV_ROOT="${TICVLA_REPO_ROOT}/DynaNav"
export TICVLA_BASE_MODEL_PATH=/data/ticvla/models/InternVL3-1B
export TICVLA_CHECKPOINT_PATH=/data/ticvla/dataset/TIC-VLA-model.ckpt
# Keep runtime files in the host user's writable home directory. Override this
# after sourcing the file if another writable output location is preferred.
export TICVLA_OUTPUT_DIR="${HOME}/ticvla_outputs"

# Headless mode works without an X11 display. Override to 0 for a local GUI.
export TICVLA_HEADLESS=1
export CUDA_VISIBLE_DEVICES=0
